# ==============================================================================
# 1. FUNCIÓN AUXILIAR PARA CALCULAR PORCENTAJES CON FORMATO
# ==============================================================================
calcular_proporciones <- function(data, variable, nombre_var) {
  data %>%
    filter(!is.na({{ variable }})) %>%
    count({{ variable }}, name = "n") %>%
    mutate(
      Variable = nombre_var,
      Categoria = as.character({{ variable }}),
      Porcentaje_num = round((n / sum(n)) * 100, 2),
      Porcentaje = paste0(format(Porcentaje_num, nsmall = 1, decimal.mark = ","), "%")
    ) %>%
    select(Variable, Categoria, n, Porcentaje)
}

# ==============================================================================
# 2. PROPORCIONES PARA TODA LA MUESTRA COMBINADA (Total 2024 - 2026)
# ==============================================================================
# Asumiendo que tu base conjunta se llama 'datos_finales' o 'base_total'

prop_genero_total <- calcular_proporciones(datos_finales, sexo, "Género")
prop_nse_total    <- calcular_proporciones(datos_finales, nse_colegio, "NSE Establecimiento")
prop_rama_total   <- calcular_proporciones(datos_finales, rama, "Rama Educacional")

# Consolidar en una única tabla para toda la muestra
tabla_sociodemo_total <- bind_rows(
  prop_genero_total,
  prop_nse_total,
  prop_rama_total
)

print("Distribución sociodemográfica para toda la muestra consolidada (2024-2026):")
print(tabla_sociodemo_total)

# ==============================================================================
# 3. PROPORCIONES POR AÑO / COHORTE (Evolución de la muestra general)
# ==============================================================================
# Si quieres ver cómo se distribuyen estas variables en cada año (ej. 2024, 2025, 2026):

calcular_proporciones_cohorte <- function(data, variable, nombre_var) {
  data %>%
    filter(!is.na({{ variable }})) %>%
    group_by(cohorte, {{ variable }}) %>%
    summarise(n = n(), .groups = "drop") %>%
    group_by(cohorte) %>%
    mutate(
      Variable = nombre_var,
      Categoria = as.character({{ variable }}),
      Porcentaje_num = round((n / sum(n)) * 100, 2),
      Porcentaje = paste0(format(Porcentaje_num, nsmall = 1, decimal.mark = ","), "%")
    ) %>%
    select(cohorte, Variable, Categoria, n, Porcentaje)
}

tabla_sociodemo_anual <- bind_rows(
  calcular_proporciones_cohorte(datos_finales, sexo, "Género"),
  calcular_proporciones_cohorte(datos_finales, nse_colegio, "NSE Establecimiento"),
  calcular_proporciones_cohorte(datos_finales, rama, "Rama Educacional")
)

print("Distribución sociodemográfica por cohorte/año:")
print(tabla_sociodemo_anual)

